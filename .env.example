# Copy to .env and adjust. Everything below is a DEVELOPMENT default,
# not a secret: change the password before exposing the stack anywhere.

# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prices

# Application settings. By default docker-compose.yml builds DATABASE_URL from the
# POSTGRES_* values above and REDIS_URL from the "redis" service. Uncommenting them here
# overrides those defaults in every application container (e.g. to use an external server).
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/prices
# REDIS_URL=redis://redis:6379/0
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_TIMEOUT_SECONDS=10
